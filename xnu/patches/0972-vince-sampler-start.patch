diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index b40eccd..814a423 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -10,7 +10,8 @@
  * with tools/sweet-crash.py). A thread blocked in a syscall shows the
  * syscall stub in pc and its caller in lr/bt.
  *
- * First sample 90 s after start, then every 120 s, 40 samples at most.
+ * First sample 90 s after start, then every 120 s, 40 samples at most (vince: 45 s and 30 s;
+ * boot-args sweetsample_first=SECONDS and sweetsample_every=SECONDS change both).
  */
 #include <sys/param.h>
 #include <sys/systm.h>
@@ -70,11 +71,25 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 	if (sweet_sample_names[0] == '-') {
 		return;
 	}
-	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
+#if defined(VINCE)
+	/* vince: the first sample while backboardd is still starting, then every 30 s */
+	uint32_t first = 45, every = 30;
+#else
+	uint32_t first = 90, every = 120;
+#endif
+	(void)PE_parse_boot_argn("sweetsample_first", &first, sizeof(first));
+	(void)PE_parse_boot_argn("sweetsample_every", &every, sizeof(every));
+	if (first == 0 || first > 3600) {
+		first = 45;
+	}
+	if (every == 0 || every > 3600) {
+		every = 30;
+	}
+	(void)tsleep(&chan, PZERO, "sweetsmp", (int)first * hz);
 	for (int i = 0; i < 40; i++) {
 		printf("SMP --- sample %d\n", i);
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
-		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+		(void)tsleep(&chan, PZERO, "sweetsmp", (int)every * hz);
 	}
 }
 
diff --git a/bsd/dev/vince_emmc.c b/bsd/dev/vince_emmc.c
index c29be85..8b710ec 100644
--- a/bsd/dev/vince_emmc.c
+++ b/bsd/dev/vince_emmc.c
@@ -79,6 +79,7 @@ static struct {
 	bool pio;
 	bool gpt_ok;                    /* both CRCs matched */
 	bool ready;
+	uint64_t st_ops[2], st_sect[2], st_us;  /* transfers [read, write], sectors, time spent in them (under the lock) */
 	int bmajor, cmajor;
 	dev_t bdev;
 	char name[37];
@@ -256,8 +257,13 @@ ve_xfer(uint64_t lba, uint32_t count, bool write)
 	int r = 0;
 
 	for (int attempt = 0; attempt < 3; attempt++) {
+		uint64_t t0 = ve_us(&ve.e);
+
 		r = write ? emmc_write(&ve.e, lba, count) : emmc_read(&ve.e, lba, count);
 		if (r == 0) {
+			ve.st_ops[write]++;
+			ve.st_sect[write] += count;
+			ve.st_us += ve_us(&ve.e) - t0;
 			return 0;
 		}
 		printf("VINCE EMMC: %s of %u sectors at %llu failed (%d, %s, cmd%u int=%x)\n",
@@ -722,6 +728,7 @@ ve_writetest(void)
  */
 extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);   /* bsd/dev/sweet_ufs.c */
 extern uint64_t sweet_log_position(void);
+extern void sweet_sample_start(void);                                       /* bsd/dev/sweet_sample.c */
 
 #define VL_RING         (4u << 20)
 #define VL_HDR_SECT     8u                                  /* one 4 KiB block for the header */
@@ -860,6 +867,8 @@ static void
 vl_thread(__unused void *arg, __unused wait_result_t wr)
 {
 	uint64_t flushed = 0, seq = 0;
+	uint64_t prev_ops[2] = { 0, 0 }, prev_sect[2] = { 0, 0 }, prev_us = 0;
+	uint32_t rounds = 0, per = 30 / vl_secs ? 30 / vl_secs : 1;
 	int fails = 0;
 
 	printf("VINCE LOG: console log to the last %u KiB of \"%s\" (sector %llu), every %u s\n",
@@ -868,6 +877,18 @@ vl_thread(__unused void *arg, __unused wait_result_t wr)
 		(void)tsleep(&vl_chan, PZERO, "vincelog", hz * (int)vl_secs);
 		int r = vl_round(&flushed, &seq);
 
+		/* a line about the eMMC load every ~30 s: is everything waiting for the disk? */
+		if (++rounds % per == 0) {
+			uint64_t ops[2] = { ve.st_ops[0], ve.st_ops[1] }, sect[2] = { ve.st_sect[0], ve.st_sect[1] }, us = ve.st_us;
+
+			printf("VINCE EMMC: last %u s: %llu reads %llu KiB, %llu writes %llu KiB, busy %llu ms\n", per * vl_secs,
+			    (unsigned long long)(ops[0] - prev_ops[0]), (unsigned long long)((sect[0] - prev_sect[0]) / 2),
+			    (unsigned long long)(ops[1] - prev_ops[1]), (unsigned long long)((sect[1] - prev_sect[1]) / 2),
+			    (unsigned long long)((us - prev_us) / 1000));
+			prev_ops[0] = ops[0]; prev_ops[1] = ops[1];
+			prev_sect[0] = sect[0]; prev_sect[1] = sect[1];
+			prev_us = us;
+		}
 		if (r == 0 || r == EAGAIN) {
 			fails = 0;
 		} else if (++fails >= 3) {
@@ -1013,6 +1034,8 @@ vince_emmc_init(void)
 	ve.ready = true;
 	printf("VINCE EMMC: emmcroot0 ready, %s\n", ve.writable ? "READ-WRITE" : "read-only");
 	vl_start();
+	/* the process sampler (patch 0054) is started by the UFS driver on sweet; here by the eMMC one */
+	sweet_sample_start();
 	return 0;
 }
 
