From ad9005f8ce607b3afb7ac459ec83c3939ab592fb Mon Sep 17 00:00:00 2001
From: claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 06:52:31 +0000
Subject: [PATCH] 0977 vince: give CPU cluster 1 the same clock as cluster 0,
 print MHz per CPU

LK leaves CPUs 4-7 on the 19.2 MHz XO. From patches 0114/0115 of arabaci0711-ux/ios-vince.
Boot-arg vinceclk=0 leaves the clocks alone.
---
 iokit/Kernel/arm/SweetCPU.cpp | 80 +++++++++++++++++++++++++++++++++++
 1 file changed, 80 insertions(+)

diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index dedb5b8..f17053c 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -30,6 +30,74 @@ extern "C" void sweet_gic_send_sgi(unsigned int target_cpu, unsigned int sgi);
 #define SWEET_CPU_NAME "Kryo 260"
 #endif
 
+#if defined(VINCE)
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/*
+ * Patch 0977: from patches 0114/0115 of https://github.com/arabaci0711-ux/ios-vince.
+ * This CPU's clock in MHz: PMCCNTR_EL0 against CNTVCT over about 10 ms (busy). LK leaves the
+ * A53 clusters at whatever it booted them with; there is no cpufreq here.
+ */
+static uint32_t
+vince_cpu_mhz(void)
+{
+	uint64_t pmcr = __builtin_arm_rsr64("PMCR_EL0");
+	__builtin_arm_wsr64("PMCR_EL0", (pmcr | 1) & ~(1ULL << 3));      /* enable, count every cycle (D = 0) */
+	__builtin_arm_wsr64("PMCNTENSET_EL0", 1ULL << 31);
+	__builtin_arm_isb(ISB_SY);
+	uint64_t f = __builtin_arm_rsr64("CNTFRQ_EL0");
+	uint64_t t0 = __builtin_arm_rsr64("CNTVCT_EL0"), c0 = __builtin_arm_rsr64("PMCCNTR_EL0");
+	uint64_t t1, c1;
+	do {
+		__builtin_arm_isb(ISB_SY);
+		t1 = __builtin_arm_rsr64("CNTVCT_EL0");
+	} while (t1 - t0 < f / 100);
+	c1 = __builtin_arm_rsr64("PMCCNTR_EL0");
+	return f ? (uint32_t)((c1 - c0) * f / (t1 - t0) / 1000000) : 0;
+}
+
+static uint32_t gVinceMHz[8];
+
+/*
+ * Cluster clock muxes (Android DT qcom,cpu-clock-8953: c0-mux 0x0b111050, c1-mux 0x0b011050;
+ * CMD +0, CFG +4, CFG src_sel bits 8-10: 0 XO, 4 GPLL0, 5 the A53 PLL). Measured on the fork's phone:
+ * LK leaves cluster 0 (MPIDR 0x0xx) on GPLL0 = 800 MHz (CFG 0x401) and cluster 1 (MPIDR 0x1xx) on
+ * XO = 19.2 MHz, so threads on CPUs 4-7 run 40 times slower. Both clusters share VDD_APC, which already
+ * carries cluster 0 at 800 MHz: give cluster 1 the same source. Does nothing unless the muxes look
+ * exactly like that. Boot-arg vinceclk=0 leaves the clocks alone.
+ */
+static void
+vince_cluster1_clock(void)
+{
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("vinceclk", &on, sizeof(on));
+	if (!on) {
+		IOLog("VINCE CLK: vinceclk=0, cluster clocks left alone\n");
+		return;
+	}
+	vm_offset_t c0 = ml_io_map(0x0b111000, 0x1000), c1 = ml_io_map(0x0b011000, 0x1000);
+	if (!c0 || !c1) {
+		IOLog("VINCE CLK: mux mapping failed\n");
+		return;
+	}
+	volatile uint32_t *cmd1 = (volatile uint32_t *)(c1 + 0x50), *cfg1 = (volatile uint32_t *)(c1 + 0x54);
+	uint32_t cfg0 = *(volatile uint32_t *)(c0 + 0x54), old = *cfg1;
+	if (((old >> 8) & 7) != 0 || ((cfg0 >> 8) & 7) != 4) {
+		IOLog("VINCE CLK: cluster muxes c0 %#x c1 %#x, left alone\n", cfg0, old);
+		return;
+	}
+	*cfg1 = cfg0;
+	__builtin_arm_dsb(DSB_SY);
+	*cmd1 = *cmd1 | 1;          /* UPDATE */
+	__builtin_arm_dsb(DSB_SY);
+	int i = 0;
+	while ((*cmd1 & 1) && i++ < 1000) {
+		IODelay(1);
+	}
+	IOLog("VINCE CLK: cluster 1 mux %#x -> %#x (as cluster 0)%s\n", old, *cfg1, (*cmd1 & 1) ? ", update stuck" : "");
+}
+#endif
+
 class SweetCPU;
 static SweetCPU *sweet_cpus[MAX_CPUS];
 static uint32_t sweet_cpus_registered;
@@ -121,6 +189,9 @@ SweetCPU::start(IOService *provider)
 	__atomic_add_fetch(&sweet_cpus_registered, 1, __ATOMIC_ACQ_REL);
 	if (cpu == topology->boot_cpu) {
 		thread_t thread;
+#if defined(VINCE)
+		vince_cluster1_clock();         /* before any secondary is started */
+#endif
 		result = kernel_thread_start(&SweetCPU::startAll, NULL, &thread);
 		if (result != KERN_SUCCESS) {
 			panic("SWEET CPU: cannot create startup thread: %d", result);
@@ -188,6 +259,10 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 	ml_set_max_cpus(topology->max_cpu_id + 1);
 	IOLog("SWEET CPU: %u/%u CPUs initialized, SGI1 verified\n",
 	    topology->num_cpus, topology->num_cpus);
+#if defined(VINCE)
+	IOLog("VINCE CLK: MHz per CPU %u %u %u %u %u %u %u %u\n", gVinceMHz[0], gVinceMHz[1], gVinceMHz[2],
+	    gVinceMHz[3], gVinceMHz[4], gVinceMHz[5], gVinceMHz[6], gVinceMHz[7]);
+#endif
 	thread_terminate(current_thread());
 }
 
@@ -205,6 +280,11 @@ SweetCPU::initCPU(bool boot)
 		panic("SWEET CPU: cpu=%u resume is not implemented", getCPUNumber());
 	}
 	assert(cpu_number() == (int)getCPUNumber());
+#if defined(VINCE)
+	if (getCPUNumber() < 8) {
+		gVinceMHz[getCPUNumber()] = vince_cpu_mhz();
+	}
+#endif
 
 	ml_broadcast_cpu_event(CPU_BOOTED, getCPUNumber());
 
-- 
2.43.0

