+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET exec trace. launchd restarts daemons that cannot work here (bluetoothd, fairplayd.H2: no
+ * hardware) every few seconds, and their lines pushed everything else off the screen. A name is
+ * printed for its first three execs and then once in fifty.
+ *
+ * Boot-arg sweetexecdeny=name,name (default: none): an exec of one of these programs fails before
+ * dyld runs, so launchd's restarts cost almost nothing on the one CPU core.
+ */
+#define SWEET_EXEC_NAMES 64
+static LCK_MTX_DECLARE_ATTR(sweet_exec_lock, &proc_lck_grp, &proc_lck_attr);
+static struct {
+	char     name[MAXCOMLEN + 1];
+	uint32_t count;
+} sweet_exec_tab[SWEET_EXEC_NAMES];
+static unsigned int sweet_exec_used;
+static char sweet_exec_deny[96];
+static bool sweet_exec_parsed;
+
+/* Counts this exec; returns true when its line is to be printed. *deny: the name is in sweetexecdeny. */
+static bool
+sweet_exec_note(const char *name, bool *deny)
+{
+	bool print = true;
+	unsigned int slot;
+
+	*deny = false;
+	lck_mtx_lock(&sweet_exec_lock);
+	if (!sweet_exec_parsed) {
+		sweet_exec_parsed = true;
+		if (!PE_parse_boot_argn("sweetexecdeny", sweet_exec_deny, sizeof(sweet_exec_deny))) {
+			sweet_exec_deny[0] = '\0';
+		}
+	}
+	for (const char *s = sweet_exec_deny; *s != '\0';) {
+		size_t len = 0;
+
+		while (s[len] != '\0' && s[len] != ',') {
+			len++;
+		}
+		if (len > 0 && strlen(name) == len && strncmp(name, s, len) == 0) {
+			*deny = true;
+		}
+		s += len;
+		if (*s == ',') {
+			s++;
+		}
+	}
+	for (slot = 0; slot < sweet_exec_used; slot++) {
+		if (strncmp(sweet_exec_tab[slot].name, name, MAXCOMLEN) == 0) {
+			break;
+		}
+	}
+	if (slot == sweet_exec_used && slot < SWEET_EXEC_NAMES) {
+		strlcpy(sweet_exec_tab[slot].name, name, sizeof(sweet_exec_tab[slot].name));
+		sweet_exec_used++;
+	}
+	if (slot < SWEET_EXEC_NAMES) {
+		uint32_t times = ++sweet_exec_tab[slot].count;
+
+		print = times <= 3 || (times % 50) == 0;
+	}
+	lck_mtx_unlock(&sweet_exec_lock);
+	return print;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
