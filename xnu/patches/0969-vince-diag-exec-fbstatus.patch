+			if (sweet_exec_note(p->p_name, &sweet_deny)) {
+				printf("exec %s%s\n", p->p_name, sweet_deny ? " (denied)" : "");
+			}
+			if (sweet_deny) {
+				signature_failure_reason = os_reason_create(OS_REASON_EXEC, EXEC_EXIT_REASON_WRONG_PLATFORM);
+				error = EACCES;
+				goto done;
+			}
