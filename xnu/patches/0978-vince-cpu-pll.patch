From cd3a4da9a7e4cc784ba6898bf754e6748c82582c Mon Sep 17 00:00:00 2001
From: claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 07:19:13 +0000
Subject: [PATCH] 0978 vince: optional 1401/1036 MHz CPU clock (vincemhz=)

---
 iokit/Kernel/arm/SweetCPU.cpp | 78 +++++++++++++++++++++++++++++++++++
 1 file changed, 78 insertions(+)

diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index f17053c..fab85d0 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -96,6 +96,83 @@ vince_cluster1_clock(void)
 	}
 	IOLog("VINCE CLK: cluster 1 mux %#x -> %#x (as cluster 0)%s\n", old, *cfg1, (*cmd1 & 1) ? ", update stuck" : "");
 }
+
+/*
+ * Patch 0978: from patch 0180 of https://github.com/arabaci0711-ux/ios-vince, but opt-in.
+ * Boot-arg vincemhz=1401 (or 1036) runs both clusters from the APCS A53 PLL (0x0b116000, 19.2 MHz XO times
+ * L: 73 = 1401.6 MHz, 54 = 1036.8 MHz) instead of GPLL0's 800 MHz. The voltage (VDD_APC) is NOT raised: it
+ * stays as LK left it, which the fork's author says is enough for 1401.6 MHz (not verified here). Without
+ * the boot-arg nothing changes. Only acts when both cluster muxes are on GPLL0 (CFG src_sel 4, as after
+ * vince_cluster1_clock) and the PLL is still off; if the PLL does not lock the muxes are not touched.
+ */
+static void
+vince_cpu_pll(void)
+{
+	uint32_t mhz = 800;
+	(void)PE_parse_boot_argn("vincemhz", &mhz, sizeof(mhz));
+	if (mhz == 800) {
+		return;
+	}
+	uint32_t l_val = mhz == 1401 ? 73 : (mhz == 1036 ? 54 : 0);
+	if (l_val == 0) {
+		IOLog("VINCE CLK: vincemhz=%u not supported (800, 1036 or 1401)\n", mhz);
+		return;
+	}
+	vm_offset_t c0 = ml_io_map(0x0b111000, 0x1000), c1 = ml_io_map(0x0b011000, 0x1000);
+	vm_offset_t pll = ml_io_map(0x0b116000, 0x1000);
+	if (!c0 || !c1 || !pll) {
+		IOLog("VINCE CLK: PLL/mux mapping failed\n");
+		return;
+	}
+	volatile uint32_t *cmd0 = (volatile uint32_t *)(c0 + 0x50), *cfg0 = (volatile uint32_t *)(c0 + 0x54);
+	volatile uint32_t *cmd1 = (volatile uint32_t *)(c1 + 0x50), *cfg1 = (volatile uint32_t *)(c1 + 0x54);
+	volatile uint32_t *mode = (volatile uint32_t *)(pll + 0x00);
+	if (((*cfg0 >> 8) & 7) != 4 || ((*cfg1 >> 8) & 7) != 4 || (*mode & 7) != 0) {
+		IOLog("VINCE CLK: vincemhz: muxes %#x %#x, PLL mode %#x: not as expected, left alone\n", *cfg0, *cfg1, *mode);
+		return;
+	}
+	*(volatile uint32_t *)(pll + 0x20) = 0x200D4828;        /* CONFIG_CTL_LO */
+	*(volatile uint32_t *)(pll + 0x24) = 0x00000006;        /* CONFIG_CTL_HI */
+	*(volatile uint32_t *)(pll + 0x30) = 0x1C000000;        /* TEST_CTL_LO */
+	*(volatile uint32_t *)(pll + 0x34) = 0x00004000;        /* TEST_CTL_HI */
+	*(volatile uint32_t *)(pll + 0x18) = 0x00000109;        /* USER_CTL */
+	*(volatile uint32_t *)(pll + 0x08) = l_val;             /* L_VAL */
+	*mode = 0x2;                                            /* BYPASSNL */
+	__builtin_arm_dsb(DSB_SY);
+	IODelay(10);
+	*mode = 0x6;                                            /* + RESET_N */
+	__builtin_arm_dsb(DSB_SY);
+	int t = 10000;
+	while ((*mode & (1U << 31)) == 0 && t > 0) {
+		IODelay(1);
+		t--;
+	}
+	if (t <= 0) {
+		IOLog("VINCE CLK: A53 PLL did not lock (mode %#x), muxes untouched\n", *mode);
+		*mode = 0;
+		return;
+	}
+	*mode = 0x7;                                            /* + OUTCTRL */
+	__builtin_arm_dsb(DSB_SY);
+	/* cluster 1 first (its CPUs are not started yet), then the boot CPU's cluster */
+	*cfg1 = 0x501;                                          /* src_sel 5 = A53 PLL, div 1 */
+	__builtin_arm_dsb(DSB_SY);
+	*cmd1 = *cmd1 | 1;
+	__builtin_arm_dsb(DSB_SY);
+	for (t = 1000; (*cmd1 & 1) && t > 0; t--) {
+		IODelay(1);
+	}
+	bool stuck1 = (*cmd1 & 1) != 0;
+	*cfg0 = 0x501;
+	__builtin_arm_dsb(DSB_SY);
+	*cmd0 = *cmd0 | 1;
+	__builtin_arm_dsb(DSB_SY);
+	for (t = 1000; (*cmd0 & 1) && t > 0; t--) {
+		IODelay(1);
+	}
+	IOLog("VINCE CLK: A53 PLL locked (L=%u, ~%u MHz), muxes c0 %#x c1 %#x%s%s\n", l_val, mhz, *cfg0, *cfg1,
+	    stuck1 ? ", c1 update stuck" : "", (*cmd0 & 1) ? ", c0 update stuck" : "");
+}
 #endif
 
 class SweetCPU;
@@ -191,6 +268,7 @@ SweetCPU::start(IOService *provider)
 		thread_t thread;
 #if defined(VINCE)
 		vince_cluster1_clock();         /* before any secondary is started */
+		vince_cpu_pll();                /* vincemhz=1401 only */
 #endif
 		result = kernel_thread_start(&SweetCPU::startAll, NULL, &thread);
 		if (result != KERN_SUCCESS) {
-- 
2.43.0

