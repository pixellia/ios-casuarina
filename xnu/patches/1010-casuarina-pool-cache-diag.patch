diff --git a/iokit/Kernel/arm/VinceGPU.cpp b/iokit/Kernel/arm/VinceGPU.cpp
index 481ed14..cc47872 100644
--- a/iokit/Kernel/arm/VinceGPU.cpp
+++ b/iokit/Kernel/arm/VinceGPU.cpp
@@ -155,6 +155,19 @@ cacheMode(void)
 	return mode == 1;
 }
 
+/*
+ * The cache mode the pool's physical descriptors are created with. Left at the default, IODefaultCacheBits() asks
+ * pmap_cache_attributes(), which answers VM_WIMG_IO (Device memory) for a physical address the VM does not manage
+ * and that is in no io-range, so the device pager of the buffer starts out as Device memory whatever the mapping
+ * asks for later. Device (and non-cacheable) memory faults on unaligned and atomic accesses (EXC_ARM_DA_ALIGN).
+ * Create the descriptor with the mode the buffer is mapped with (kIOMemoryBufferCacheShift: cache mode of a descriptor).
+ */
+static IOOptionBits
+poolCacheOption(void)
+{
+	return (IOOptionBits)((cacheMode() ? kIOCopybackCache : kIOWriteCombineCache) << kIOMemoryBufferCacheShift);
+}
+
 static void
 cacheSync(struct gpu_buffer *b)
 {
@@ -814,7 +827,7 @@ VinceGPUUserClient::gemNew(struct msm_gem_new *request)
 	}
 	IOLockUnlock(gGPULock);
 	if (pooled != 0) {
-		memory = IOMemoryDescriptor::withAddressRange(pooled, size, kIODirectionInOut | kIOMemoryTypePhysical64, NULL);
+		memory = IOMemoryDescriptor::withAddressRange(pooled, size, kIODirectionInOut | kIOMemoryTypePhysical64 | poolCacheOption(), NULL);
 		if (memory == NULL) {
 			IOLockLock(gGPULock);
 			poolFree(pooled, size);
@@ -912,7 +925,7 @@ VinceGPUUserClient::surfaceBuffer(struct vince_surface_req *request)
 		return kIOReturnSuccess;
 	}
 
-	memory = IOMemoryDescriptor::withAddressRange(s->poolPhys, s->poolSize, kIODirectionInOut | kIOMemoryTypePhysical64, NULL);
+	memory = IOMemoryDescriptor::withAddressRange(s->poolPhys, s->poolSize, kIODirectionInOut | kIOMemoryTypePhysical64 | poolCacheOption(), NULL);
 	if (memory == NULL) {
 		s->release();
 		return kIOReturnNoMemory;
diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 9298a64..453935d 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -7453,6 +7453,10 @@ pmap_has_managed_page(ppnum_t first, ppnum_t last)
 	if (ptoa(last) < vm_first_phys) {
 		return FALSE;
 	}
+	/* vince: the hole between the two banks (vinceram3g=1) holds the GPU pool; none of it is managed */
+	if (vince_gap_end != 0 && ptoa(first) >= vince_gap_start && ptoa(last) < vince_gap_end) {
+		return FALSE;
+	}
 
 	return TRUE;
 }
