From 61707dc04021857634136a4bc41bb9b7e4386c1f Mon Sep 17 00:00:00 2001
From: x <a@b>
Date: Tue, 10 Nov 2026 12:50:47 +0000
Subject: [PATCH] 1001 vince: read the MDP pipes at their real offsets in
 vincemdpdump

The dump used the pipe offsets of an MDSS-relative table against the MDP base, so it read
0x15000, which the RGB0 block does not decode, and the bus aborted. Use +0x4000/+0x14000/
+0x16000/+0x24000 and read only the first 0x40 bytes of each pipe.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UTtYRgmKyxgNh36HwFrzar
---
 bsd/dev/vince_adreno.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/vince_adreno.c b/bsd/dev/vince_adreno.c
index 2494833..4ca2051 100644
--- a/bsd/dev/vince_adreno.c
+++ b/bsd/dev/vince_adreno.c
@@ -1030,7 +1030,8 @@ static int adreno_chan;
 
 /*
  * vincemdpdump=1: print the display controller (MDP5) registers once, read only, so the scan-out can be
- * understood before anything is changed. Offsets are from the MDP base (MDSS 0x01a00000 + 0x1000).
+ * understood before anything is changed. Offsets are from the MDP base (MDSS 0x01a00000 + 0x1000); the pipes sit at +0x4000 (VIG0), +0x14000/+0x16000 (RGB0/1), +0x24000 (DMA0).
+ * Only the start of each block is read: an offset the block does not have makes the bus abort.
  */
 static void
 vince_mdp_dump(void)
@@ -1038,8 +1039,8 @@ vince_mdp_dump(void)
 	static const struct { const char *name; uint32_t off; uint32_t len; } win[] = {
 		{ "HW", 0x000, 0x20 }, { "INTF_SEL", 0x100, 0x10 },
 		{ "CTL0", 0x600, 0x40 }, { "CTL1", 0x700, 0x40 },
-		{ "VIG0", 0x5000, 0x60 }, { "RGB0", 0x15000, 0x60 }, { "RGB1", 0x17000, 0x60 }, { "DMA0", 0x25000, 0x60 },
-		{ "INTF1", 0x6a800, 0x80 },
+		{ "RGB0", 0x14000, 0x40 }, { "RGB1", 0x16000, 0x40 }, { "DMA0", 0x24000, 0x40 }, { "VIG0", 0x4000, 0x40 },
+		{ "INTF1", 0x6a800, 0x60 },
 	};
 	vm_offset_t va = ml_io_map(0x01a01000, 0x6c000);
 	uint32_t w, o;
