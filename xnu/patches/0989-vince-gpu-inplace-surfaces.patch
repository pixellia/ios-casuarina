+/*
+ * The memory of an IOSurface as a buffer (vinceplace=1): only a surface that SweetSurface made from the pool (the
+ * window server's screen-sized ones) is one the GPU can address; every other is refused, and the library then fills
+ * a texture from it and reads the frame back as before. The surface is held for as long as the buffer is there. A
+ * surface that already is a buffer of this client's is that buffer again. kVinceDescribe asks what the buffer would
+ * be like and makes none.
+ */
+IOReturn
+VinceGPUUserClient::surfaceBuffer(struct vince_surface_req *request)
+{
+	SweetSurface *s = sweet_surface_copy(request->surface);
+	IOMemoryDescriptor *memory;
+	struct gpu_buffer *b = NULL;
+	bool describe = request->handle == kVinceDescribe;
+
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	if (!s->vincePool || s->memory == NULL || s->poolSize == 0 || s->poolSize > GPU_BUFFER_MAX || fBuffers == NULL) {
+		s->release();
+		return kIOReturnUnsupported;
+	}
+	request->size = s->poolSize;
+	request->offset = s->offset;
+	request->rowBytes = s->bytesPerRow;
+	request->width = s->width;
+	request->height = s->height;
+	request->pixelFormat = s->pixelFormat;
+	request->planes = s->planeCount;
+	if (describe) {
+		request->handle = 0;
+		s->release();
+		return kIOReturnSuccess;
+	}
+
+	memory = IOMemoryDescriptor::withAddressRange(s->poolPhys, s->poolSize, kIODirectionInOut | kIOMemoryTypePhysical64, NULL);
+	if (memory == NULL) {
+		s->release();
+		return kIOReturnNoMemory;
+	}
+	IOLockLock(gGPULock);
+	for (uint32_t i = 0; i < GPU_BUFFERS; i++) {
+		if (fBuffers[i].memory != NULL && fBuffers[i].surface == s) {
+			b = &fBuffers[i];
+			request->handle = i + 1;
+			break;
+		}
+	}
+	if (b != NULL) {
+		memory->release();
+		s->release();
+	} else {
+		for (uint32_t n = 0; n < GPU_BUFFERS; n++) {
+			uint32_t h = (fNextBuffer + n) % GPU_BUFFERS;
+			if (fBuffers[h].memory == NULL) {
+				b = &fBuffers[h];
+				fNextBuffer = h + 1;
+				request->handle = h + 1;
+				break;
+			}
+		}
+		if (b != NULL) {
+			bzero(b, sizeof(*b));
+			b->memory = memory;
+			b->surface = s;
+			b->address = s->poolPhys;
+			b->size = s->poolSize;
+			b->pooled = false;
+		}
+	}
+	IOLockUnlock(gGPULock);
+	if (b == NULL) {
+		memory->release();
+		s->release();
+		return kIOReturnNoMemory;
+	}
+	static uint32_t told;
+	if (told++ < 16) {
+		IOLog("VinceGPU: IOSurface %u (%ux%u) is buffer %u at %#llx\n", request->surface, request->width, request->height,
+		    request->handle, (unsigned long long)s->poolPhys);
+	}
+	return kIOReturnSuccess;
+}
