+/*
+ * vinceplace=1 (with vincecache=1, which the cached maps need): the window server's screen-sized surfaces come from
+ * the pool and the GPU draws into them in place, instead of the frames being read back by the processor.
+ */
+bool
+vince_place_enabled(void)
+{
+	static int mode = -1;
+
+	if (mode < 0) {
+		uint32_t place = 0;
+		mode = PE_parse_boot_argn("vinceplace", &place, sizeof(place)) && place && cacheMode();
+	}
+	return mode == 1 && gPoolLock != NULL && vince_gpu_ready();
+}
+
+uint64_t
+vince_pool_alloc(uint64_t size)
+{
+	uint64_t pa = 0;
+
+	if (gPoolLock == NULL || size == 0 || size > GPU_BUFFER_MAX) {
+		return 0;
+	}
+	IOLockLock(gPoolLock);
+	/* the buffers of the library need room too: the screens take at most 8 of the 192 MiB's 12 */
+	if (gPlaceHeld < 8) {
+		pa = poolAllocLocked(size);
+		if (pa != 0) {
+			gPlaceHeld++;
+		}
+	}
+	IOLockUnlock(gPoolLock);
+	return pa;
+}
+
+void
+vince_pool_free(uint64_t pa, uint64_t size)
+{
+	IOLockLock(gPoolLock);
+	poolFreeLocked(pa, size);
+	if (gPlaceHeld != 0) {
+		gPlaceHeld--;
+	}
+	IOLockUnlock(gPoolLock);
+}
+
+/*
+ * The display is about to read the picture of a surface the GPU draws into: wait for the last submission that names
+ * it, then drop what the processor's cache holds of it (the GPU does not snoop it), so that the reads go to RAM.
+ */
+void
+vince_surface_sync(SweetSurface *s)
+{
+	uint32_t fence = s->vinceDrawn;
+	uintptr_t va;
+
+	if (!s->vincePool) {
+		return;
+	}
+	if (fence != 0 && !gpuWait(fence, 100)) {
+		static uint32_t told;
+		if (told++ < 8) {
+			IOLog("VinceGPU: the display did not wait long enough for fence %u\n", fence);
+		}
+	}
+	va = s->kernelAddress();
+	if (va != 0) {
+		sweet_dcache_flush((vm_offset_t)va, (unsigned)s->poolSize);
+	}
+}
