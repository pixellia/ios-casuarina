From 63cf8d21edcc59d6841d421be20ca33625d9bc0c Mon Sep 17 00:00:00 2001
From: x <a@b>
Date: Tue, 10 Nov 2026 11:45:21 +0000
Subject: [PATCH] 1000 vince: vincemdpdump=1 prints the display controller
 registers (read only)

Dumps MDP5 registers once at boot (CTL0/1, VIG0, RGB0/1, DMA0, INTF1, interface select) so the
scan-out can be understood before double-buffering the panel. Nothing is written.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UTtYRgmKyxgNh36HwFrzar
---
 bsd/dev/vince_adreno.c | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/bsd/dev/vince_adreno.c b/bsd/dev/vince_adreno.c
index dd3e44c..2494833 100644
--- a/bsd/dev/vince_adreno.c
+++ b/bsd/dev/vince_adreno.c
@@ -1028,6 +1028,34 @@ static step_fn steps[11] = {
 
 static int adreno_chan;
 
+/*
+ * vincemdpdump=1: print the display controller (MDP5) registers once, read only, so the scan-out can be
+ * understood before anything is changed. Offsets are from the MDP base (MDSS 0x01a00000 + 0x1000).
+ */
+static void
+vince_mdp_dump(void)
+{
+	static const struct { const char *name; uint32_t off; uint32_t len; } win[] = {
+		{ "HW", 0x000, 0x20 }, { "INTF_SEL", 0x100, 0x10 },
+		{ "CTL0", 0x600, 0x40 }, { "CTL1", 0x700, 0x40 },
+		{ "VIG0", 0x5000, 0x60 }, { "RGB0", 0x15000, 0x60 }, { "RGB1", 0x17000, 0x60 }, { "DMA0", 0x25000, 0x60 },
+		{ "INTF1", 0x6a800, 0x80 },
+	};
+	vm_offset_t va = ml_io_map(0x01a01000, 0x6c000);
+	uint32_t w, o;
+
+	if (va == 0) {
+		printf("VINCE MDP: could not map the registers\n");
+		return;
+	}
+	for (w = 0; w < sizeof(win) / sizeof(win[0]); w++) {
+		for (o = 0; o < win[w].len; o += 0x10) {
+			volatile uint32_t *r = (volatile uint32_t *)(va + win[w].off + o);
+			printf("VINCE MDP: %s+%#x: %08x %08x %08x %08x\n", win[w].name, o, r[0], r[1], r[2], r[3]);
+		}
+	}
+}
+
 static void
 adreno_run(void)
 {
@@ -1037,6 +1065,9 @@ adreno_run(void)
 	extern unsigned int vm_page_free_count;
 
 	printf("VINCE RAM: %llu MiB (max_mem), %u pages free\n", (unsigned long long)(max_mem >> 20), vm_page_free_count);
+	if (PE_parse_boot_argn("vincemdpdump", &arg, sizeof(arg)) && arg != 0) {
+		vince_mdp_dump();
+	}
 	if (!PE_parse_boot_argn("adreno", &last_step, sizeof(last_step))) {
 		if (PE_parse_boot_argn("gpu", &arg, sizeof(arg)) && arg) {
 			last_step = 11;
-- 
