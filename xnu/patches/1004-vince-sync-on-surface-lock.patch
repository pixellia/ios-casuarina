From 54caa6bf3b55ac5f8ac0fdb9712e43a0afb922b8 Mon Sep 17 00:00:00 2001
From: x <a@b>
Date: Wed, 11 Nov 2026 09:51:38 +0000
Subject: [PATCH] 1004 vince: sync a pooled surface when a program locks it,
 not only when the display reads it

With vinceplace=1 the GPU draws into backboardd's screen surfaces. The display waited for the GPU and
dropped the cache before reading them, but a program that locks the surface (the CPU refill of a backdrop
texture, for instance) got stale cache lines: black Control Center, remnants of the old image. trapLock now
does the same sync, and the sync is skipped when the GPU has not drawn into the surface since the last one.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UTtYRgmKyxgNh36HwFrzar
---
 iokit/Kernel/arm/SweetSurface.cpp | 4 ++++
 iokit/Kernel/arm/SweetSurface.h   | 3 ++-
 iokit/Kernel/arm/VinceGPU.cpp     | 7 ++++---
 3 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index 394e5e9..66b9622 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -1732,6 +1732,10 @@ IOSurfaceRootUserClient::trapLock(void *id, __unused void *options, void *seedOu
 	if (s == NULL) {
 		return kIOReturnNotFound;
 	}
+	if (s->vincePool) {
+		/* a program is about to read or write the picture: the GPU may have drawn it, and its cache does not know */
+		vince_surface_sync(s);
+	}
 	IOReturn ret = sweet_surface_seed_out(s, seedOut, false);
 	s->release();
 	return ret;
diff --git a/iokit/Kernel/arm/SweetSurface.h b/iokit/Kernel/arm/SweetSurface.h
index ac4f978..0637b09 100644
--- a/iokit/Kernel/arm/SweetSurface.h
+++ b/iokit/Kernel/arm/SweetSurface.h
@@ -51,8 +51,9 @@ public:
 	bool                      vincePool;    /* vince (vinceplace=1): memory from VinceGPU's pool, which the GPU draws into in place */
 	uint64_t                  poolPhys;     /* ... its physical address (= the GPU's), */
 	uint32_t                  vinceDrawn;   /* ... and the last submission of VinceGPU that names it */
+	uint32_t      vinceSynced;      /* ... and the one whose picture the cache was last dropped for */
 
-	bool init() APPLE_KEXT_OVERRIDE { scanoutPhys = 0; scanoutSlot = -1; values = NULL; purgeable = 0; wrapDelta = 0; wrapped = false; drawn = 0; gpuPool = false; poolSize = 0; vincePool = false; poolPhys = 0; vinceDrawn = 0; return OSObject::init(); }
+	bool init() APPLE_KEXT_OVERRIDE { scanoutPhys = 0; scanoutSlot = -1; values = NULL; purgeable = 0; wrapDelta = 0; wrapped = false; drawn = 0; gpuPool = false; poolSize = 0; vincePool = false; poolPhys = 0; vinceDrawn = 0; vinceSynced = 0; return OSObject::init(); }
 	void free() APPLE_KEXT_OVERRIDE;
 
 	/* Kernel address of the pixels (mapped on first use), or 0. */
diff --git a/iokit/Kernel/arm/VinceGPU.cpp b/iokit/Kernel/arm/VinceGPU.cpp
index 2f152b9..59b1f71 100644
--- a/iokit/Kernel/arm/VinceGPU.cpp
+++ b/iokit/Kernel/arm/VinceGPU.cpp
@@ -450,10 +450,10 @@ vince_surface_sync(SweetSurface *s)
 	uint32_t fence = s->vinceDrawn;
 	uintptr_t va;
 
-	if (!s->vincePool) {
-		return;
+	if (!s->vincePool || fence == 0 || fence == s->vinceSynced) {
+		return;         /* the GPU has not drawn into it since the cache was last dropped */
 	}
-	if (fence != 0 && !gpuWait(fence, 100)) {
+	if (!gpuWait(fence, 100)) {
 		static uint32_t told;
 		if (told++ < 8) {
 			IOLog("VinceGPU: the display did not wait long enough for fence %u\n", fence);
@@ -463,6 +463,7 @@ vince_surface_sync(SweetSurface *s)
 	if (va != 0) {
 		sweet_dcache_flush((vm_offset_t)va, (unsigned)s->poolSize);
 	}
+	s->vinceSynced = fence;
 }
 
 void
